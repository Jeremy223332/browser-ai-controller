{
  "manifest_version": 3,
  "name": "Browser AI Controller",
  "version": "1.0.0",
  "description": "AI assistant that can control Chrome and perform browser actions.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.google.com/*"
  ],
  "action": {
    "default_title": "Open Browser AI"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
