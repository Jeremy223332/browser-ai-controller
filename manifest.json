{
  "manifest_version": 3,
  "name": "Browser AI Controller",
  "version": "1.0.0",
  "description": "AI assistant that can control Chrome and perform browser actions.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
